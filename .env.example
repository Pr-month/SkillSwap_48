# Переменные для docker compose. Все необязательны — без .env используются значения по умолчанию.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skillswap

BACKEND_PORT=3000
NODE_ENV=development
DB_LOGGING=false
HASH_SALT=10

JWT_ACCESS_SECRET=skillswap_dev_access_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=skillswap_dev_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin1234
