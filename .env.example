# Переменные для docker compose.
# Обязательные (без них compose не запустится):
#   POSTGRES_PASSWORD, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, ADMIN_PASSWORD
# Скопируйте файл: cp .env.example .env, затем заполни обязательные поля.
# Значения со спецсимволами (@ : / # $) бери в одинарные кавычки.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=skillswap

BACKEND_PORT=3000
NODE_ENV=development
DB_LOGGING=false
HASH_SALT=10

# Сгенерировать секрет:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=
