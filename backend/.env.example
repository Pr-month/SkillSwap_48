# JWT (секреты обязательны, сгенерировать:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Admin seeding
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=

# Инструкция по созданию базы данных и настройке подключения:
# docs/database-setup.md

DB_MODE=local

# Локальная БД: либо одной строкой, либо отдельными переменными (ниже).
# Если пароль со спецсимволами (@ : / # %), используй отдельные переменные.
LOCAL_DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/skillswap"

# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=skillswap

DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_SUPABASE_PASSWORD@SESSION_POOLER_HOST:5432/postgres?uselibpqcompat=true&sslmode=require"

DB_LOGGING=true

PORT=3000
HASH_SALT=10

# development | production (production — включать secure-куки)
NODE_ENV=development
